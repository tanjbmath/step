rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function ownsAssignment(assignmentId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/assignments/$(assignmentId))
        && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.teacherId == request.auth.uid;
    }

    function isAssignmentMember(assignmentId, studentUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(studentUid));
    }

    function helpOwnerPath(assignmentId, requestId) {
      return /databases/$(database)/documents/assignments/$(assignmentId)/helpRequestOwners/$(requestId);
    }

    function helpLockPath(assignmentId, workKey) {
      return /databases/$(database)/documents/assignments/$(assignmentId)/helpLocks/$(workKey);
    }

    function peerHelpEventPath(uid, eventId) {
      return /databases/$(database)/documents/users/$(uid)/peerHelpEvents/$(eventId);
    }

    function isHelpRequester(assignmentId, requestId) {
      return signedIn()
        && exists(helpOwnerPath(assignmentId, requestId))
        && get(helpOwnerPath(assignmentId, requestId)).data.requesterUid == request.auth.uid;
    }

    function isCompletedPeer(assignmentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(request.auth.uid)).data.status == 'completed';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'lastSignInAt'
        ]);

      allow update: if isOwner(uid)
        && (
          ('role' in resource.data
            && 'role' in request.resource.data
            && request.resource.data.role == resource.data.role)
          || (!('role' in resource.data) && !('role' in request.resource.data))
        )
        // Once chosen, the canonical student name and its timestamp cannot be changed or removed.
        && (
          !('studentName' in resource.data)
          || (
            'studentName' in request.resource.data
            && request.resource.data.studentName == resource.data.studentName
            && request.resource.data.studentNameSetAt == resource.data.studentNameSetAt
          )
        )
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'lastSignInAt', 'role',
          'studentName', 'studentNameSetAt'
        ]);

      allow delete: if false;

      match /peerHelpEvents/{eventId} {
        // Legacy student-to-student help events are disabled.
        allow read, write: if false;
      }

          match /submissions/{assignmentId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.assignmentId == assignmentId
          && request.resource.data.status in ['in-progress', 'submitted']
          && isAssignmentMember(assignmentId, uid);
        allow update: if (
            isOwner(uid)
            && request.resource.data.assignmentId == assignmentId
            && isAssignmentMember(assignmentId, uid)
            && resource.data.status != 'completed'
            && request.resource.data.status in ['in-progress', 'submitted']
            && (resource.data.status != 'submitted' || request.resource.data.status == 'submitted')
          ) || (
            ownsAssignment(assignmentId)
            && request.resource.data.assignmentId == assignmentId
            && request.resource.data.status in ['completed', 'in-progress']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewOutcome'])
          );
        // The assignment owner may remove each student's history record during assignment deletion.
        allow delete: if isOwner(uid) || ownsAssignment(assignmentId);
      }
    }

    // Public, minimal student directory. Documents contain only a chosen display name and timestamp.
    match /peerDirectory/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['studentName', 'nameSource', 'updatedAt'])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.nameSource in ['profile', 'chosen'];

      // A Google display name may be replaced by the student's chosen canonical name once.
      // After that, the chosen name and source cannot be changed by client updates.
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['studentName', 'nameSource', 'updatedAt'])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 80
        && (
          (
            resource.data.nameSource == 'profile'
            && request.resource.data.nameSource in ['profile', 'chosen']
          )
          || (
            resource.data.nameSource == 'chosen'
            && request.resource.data.nameSource == 'chosen'
            && request.resource.data.studentName == resource.data.studentName
          )
        );

      allow delete: if false;
    }

    // Collection-group reads are limited to the signed-in student's own email.
    match /{path=**}/assignedStudents/{studentKey} {
      allow read: if signedIn() && resource.data.studentEmail == request.auth.token.email;
    }

    // A known session code can resolve to a limited lookup record; codes cannot be listed.
    match /assignmentLookups/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if isTeacher()
        && request.resource.data.sessionCode == code
        && request.resource.data.keys().hasOnly([
          'assignmentId', 'sessionCode', 'teacherId', 'title', 'status', 'createdAt'
        ])
        && request.resource.data.teacherId == request.auth.uid
        && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.teacherId == request.auth.uid
        && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.sessionCode == code;

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && ownsAssignment(resource.data.assignmentId)
        && request.resource.data.sessionCode == code
        && request.resource.data.assignmentId == resource.data.assignmentId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.keys().hasOnly([
          'assignmentId', 'sessionCode', 'teacherId', 'title', 'status', 'createdAt'
        ]);

      allow delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && ownsAssignment(resource.data.assignmentId);
    }

    match /assignments/{assignmentId} {
      allow read: if (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (signedIn() && isAssignmentMember(assignmentId, request.auth.uid));

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.sessionCode is string
        && request.resource.data.assignedStudentCount is int
&& request.resource.data.assignedStudentCount == 0;

      allow update: if ownsAssignment(assignmentId)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.sessionCode == resource.data.sessionCode;

      allow delete: if ownsAssignment(assignmentId);

      match /assignedStudents/{studentKey} {
        allow get: if ownsAssignment(assignmentId)
          || (signedIn() && studentKey == request.auth.token.email);
        allow list: if ownsAssignment(assignmentId)
          || (signedIn() && resource.data.studentEmail == request.auth.token.email);

        allow create: if ownsAssignment(assignmentId)
          && request.resource.data.assignmentId == assignmentId
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.studentEmail is string
          && request.resource.data.status == 'assignment-started'
          && request.resource.data.keys().hasOnly([
            'assignmentId', 'studentEmail', 'teacherId', 'title', 'description',
            'sessionCode', 'classLabel', 'slideCount', 'status', 'assignedAt'
          ]);

        allow update: if (
            ownsAssignment(assignmentId)
            && request.resource.data.assignmentId == resource.data.assignmentId
            && request.resource.data.studentEmail == resource.data.studentEmail
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.status in ['completed', 'in-progress']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewOutcome'])
          ) || (
            signedIn()
            && resource.data.studentEmail == request.auth.token.email
            && request.resource.data.studentEmail == resource.data.studentEmail
            && request.resource.data.assignmentId == resource.data.assignmentId
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.status in ['in-progress', 'submitted']
            && (
              (resource.data.status == 'assignment-started' && request.resource.data.status == 'in-progress')
              || (resource.data.status == 'in-progress' && request.resource.data.status in ['in-progress', 'submitted'])
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'lastWorkedAt', 'submittedAt'])
          );

        allow delete: if ownsAssignment(assignmentId);
      }

      // Teacher Help: students may create and read only their own requests.
      // Only the assignment owner can claim, finish, or close a request.
      match /helpRequests/{requestId} {
        allow get: if ownsAssignment(assignmentId)
          || (signedIn() && resource.data.requesterUid == request.auth.uid)
          || isHelpRequester(assignmentId, requestId);

        allow list: if ownsAssignment(assignmentId)
          || (signedIn() && resource.data.requesterUid == request.auth.uid);

        allow create: if signedIn()
          && isAssignmentMember(assignmentId, request.auth.uid)
          && get(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(request.auth.uid)).data.status == 'in-progress'
          && request.resource.data.keys().hasOnly([
            'requestId', 'requesterUid', 'requesterName', 'question', 'status',
            'slideIndex', 'workKey', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.requestId == requestId
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.requesterName is string
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.question.size() <= 500
          && request.resource.data.status == 'pending'
          && request.resource.data.slideIndex is int
          && request.resource.data.workKey is string
          && getAfter(helpLockPath(assignmentId, request.resource.data.workKey)).data.requestId == requestId;

        allow update: if (
            ownsAssignment(assignmentId)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'helping'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt', 'updatedAt'])
          ) || (
            ownsAssignment(assignmentId)
            && resource.data.status == 'helping'
            && request.resource.data.status == 'submitted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'updatedAt'])
          ) || (
            ownsAssignment(assignmentId)
            && resource.data.status in ['pending', 'helping']
            && request.resource.data.status == 'expired'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiredAt', 'updatedAt'])
          );

        allow delete: if ownsAssignment(assignmentId)
          || (signedIn() && resource.data.requesterUid == request.auth.uid && resource.data.status == 'pending');
      }

      // Lock documents only coordinate the student's own request and the assignment teacher.
      match /helpLocks/{workKey} {
        allow get: if ownsAssignment(assignmentId)
          || (signedIn() && resource.data.requesterUid == request.auth.uid)
          || isHelpRequester(assignmentId, resource.data.requestId);
        allow list: if false;

        allow create: if signedIn()
          && isAssignmentMember(assignmentId, request.auth.uid)
          && request.resource.data.keys().hasOnly(['requestId', 'workKey', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.workKey == workKey
          && request.resource.data.status == 'pending'
          && getAfter(/databases/$(database)/documents/assignments/$(assignmentId)/helpRequests/$(request.resource.data.requestId)).data.requesterUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/assignments/$(assignmentId)/helpRequests/$(request.resource.data.requestId)).data.workKey == workKey;

        allow update: if (
            ownsAssignment(assignmentId)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'helping'
            && getAfter(/databases/$(database)/documents/assignments/$(assignmentId)/helpRequests/$(resource.data.requestId)).data.status == 'helping'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            ownsAssignment(assignmentId)
            && resource.data.status == 'helping'
            && request.resource.data.status == 'submitted'
            && getAfter(/databases/$(database)/documents/assignments/$(assignmentId)/helpRequests/$(resource.data.requestId)).data.status == 'submitted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) || (
            ownsAssignment(assignmentId)
            && resource.data.status in ['pending', 'helping']
            && request.resource.data.status == 'expired'
            && getAfter(/databases/$(database)/documents/assignments/$(assignmentId)/helpRequests/$(resource.data.requestId)).data.status == 'expired'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          );

        allow delete: if ownsAssignment(assignmentId);
      }

      // Legacy requester-owner mappings are retained for existing records but cannot be written
      // by the client or listed by students under the teacher-only workflow.
      match /helpRequestOwners/{requestId} {
        allow get, list: if ownsAssignment(assignmentId);
        allow create, update, delete: if false;
      }

      // No peer helper may read or write the old shared help-canvas documents.
      match /helpRequests/{requestId}/slides/{slideId} {
        allow read: if ownsAssignment(assignmentId)
          || (signedIn() && get(/databases/$(database)/documents/assignments/$(assignmentId)/helpRequests/$(requestId)).data.requesterUid == request.auth.uid);
        allow create, update, delete: if false;
      }

      match /students/{studentUid} {
        allow read: if isOwner(studentUid) || ownsAssignment(assignmentId);

        allow create: if isOwner(studentUid)
          && request.resource.data.uid == studentUid
          && request.resource.data.sessionCode is string
          && exists(/databases/$(database)/documents/assignmentLookups/$(request.resource.data.sessionCode))
          && get(/databases/$(database)/documents/assignmentLookups/$(request.resource.data.sessionCode)).data.assignmentId == assignmentId
          && exists(/databases/$(database)/documents/assignments/$(assignmentId))
          && (
            (
              exists(/databases/$(database)/documents/assignmentLookups/$(request.resource.data.sessionCode))
              && get(/databases/$(database)/documents/assignmentLookups/$(request.resource.data.sessionCode)).data.assignmentId == assignmentId
            )
            || ownsAssignment(assignmentId)
          );

        allow update: if (
            isOwner(studentUid)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.sessionCode == resource.data.sessionCode
            // A student cannot remove or replace the active lock key while a help request is open.
            && (
              !('activeHelpLockKey' in resource.data)
              || (
                'activeHelpLockKey' in request.resource.data
                && (
                  request.resource.data.activeHelpLockKey == resource.data.activeHelpLockKey
                  || get(helpLockPath(assignmentId, resource.data.activeHelpLockKey)).data.status in ['acknowledged', 'expired']
                )
              )
            )
          ) || ownsAssignment(assignmentId);

        allow delete: if ownsAssignment(assignmentId)
          || (
            isOwner(studentUid)
            && (
              // If the parent assignment has already been removed, allow cleanup of orphaned work.
              !exists(/databases/$(database)/documents/assignments/$(assignmentId))
              || !('activeHelpLockKey' in resource.data)
              || get(helpLockPath(assignmentId, resource.data.activeHelpLockKey)).data.status in ['acknowledged', 'expired']
            )
          );

        match /slides/{slideId} {
          allow read: if isOwner(studentUid) || ownsAssignment(assignmentId);
          allow create, update: if (
              isOwner(studentUid)
              && isAssignmentMember(assignmentId, studentUid)
              && (
                !('activeHelpLockKey' in get(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(studentUid)).data)
                || get(helpLockPath(assignmentId, get(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(studentUid)).data.activeHelpLockKey)).data.status != 'helping'
              )
            ) || ownsAssignment(assignmentId);
          allow delete: if ownsAssignment(assignmentId)
            || (
              isOwner(studentUid)
              && (
                // Orphaned slides can be removed after the teacher deletes the parent assignment.
                !exists(/databases/$(database)/documents/assignments/$(assignmentId))
                || !('activeHelpLockKey' in get(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(studentUid)).data)
                || get(helpLockPath(assignmentId, get(/databases/$(database)/documents/assignments/$(assignmentId)/students/$(studentUid)).data.activeHelpLockKey)).data.status in ['acknowledged', 'expired']
              )
            );
        }
      }
    }

    // Server-only AI usage counters. Admin SDK access from Cloud Functions bypasses these client rules.
    match /aiTutorUsage/{uid} {
      allow read, write: if false;
    }
  }
}
