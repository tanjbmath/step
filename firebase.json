{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "target": "stepmath",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/.git/**",
      "**/.github/**",
      "*.md",
      "worker/**",
      "wrangler.toml",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules"
    ]
  }
}
